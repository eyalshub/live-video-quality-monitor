# Copy to frontend/.env for local development. Never commit the real .env.
# All variables are required; the app shows a configuration error screen if one is missing.

# Backend base URL (no trailing slash). Locally: the uvicorn dev server.
VITE_API_BASE_URL=http://localhost:8000

# How often the outbox of samples is sent to the backend (ms). Task asks for ~1-2 s.
VITE_SAMPLE_BATCH_INTERVAL_MS=1500

# Size the camera frame is scaled to before computing brightness and motion (pixels).
VITE_ANALYSIS_WIDTH=160
VITE_ANALYSIS_HEIGHT=120

# Timeout for a single API request (ms). Long enough for a free backend's cold start (~1 min).
VITE_API_TIMEOUT_MS=70000

# Run the face detector on every Nth frame (1 = every frame). It always runs on the first frame
# of each second, so every second has a real face result. See docs/decisions/ADR-011.
VITE_FACE_DETECT_EVERY_N_FRAMES=1

# Face detector's minimum detection confidence (MediaPipe minDetectionConfidence), 0 < x < 1.
# Lower = more faces found (and more false positives). See docs/decisions/ADR-011.
VITE_FACE_MIN_CONFIDENCE=0.5

# A face counts only if it stays in about the same place for this many detector runs in a row
# (1 = off), measured on labelled recordings: a waving hand rarely stays put. See ADR-017.
VITE_FACE_STABLE_FRAMES=5
# How much the face box must overlap the previous runs' box (IoU), 0 < x < 1.
VITE_FACE_STABLE_IOU=0.3

# --- Extra insights (ADR-013): informational only, never part of the verdict or the API ---
# Sharpness = variance of the Laplacian on the downscaled luma frame. Below this -> "Blurry".
VITE_SHARPNESS_MIN=50
# % of pixels crushed (luma <= 5) or blown (luma >= 250). Above this -> warning.
VITE_CLIP_PCT_MAX=5
# Face width as % of the frame width. Below this -> "Move closer".
VITE_FACE_MIN_WIDTH_PCT=20
# Face center offset from the frame center, % of the frame size. Above this -> "Center your face".
VITE_FACE_MAX_OFFSET_PCT=20
