# Copy to backend/.env for local development. Never commit the real .env.
# Every variable is required except LOG_LEVEL (default INFO).

# Postgres connection. Local value matches docker-compose.yml.
# postgres:// and postgresql:// URLs (Neon/Render) are accepted and switched to psycopg 3.
DATABASE_URL=postgresql+psycopg://vqm:vqm@localhost:5432/vqm

# Used only by the test suite (separate DB created by docker/initdb).
TEST_DATABASE_URL=postgresql+psycopg://vqm:vqm@localhost:5432/vqm_test

# Comma-separated list of allowed frontend origins (no trailing slash, no "*").
CORS_ORIGINS=http://localhost:5173

# Verdict thresholds (ADR-002). Snapshotted on each session at creation.
THRESHOLD_FPS_MIN=15
THRESHOLD_BRIGHTNESS_MIN=60
THRESHOLD_BRIGHTNESS_MAX=200
THRESHOLD_MOTION_MAX=20

# Largest number of samples accepted in one request.
MAX_SAMPLES_PER_BATCH=120

# DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO
